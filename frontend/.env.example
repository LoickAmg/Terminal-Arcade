# Variables d'environnement du site. Copier en .env.local pour le
# développement ; en production, les renseigner dans les réglages du projet
# Vercel. Ne jamais commiter de vraie valeur.

# --- Base de données -------------------------------------------------------
# Neon (production) : chaîne de connexion « pooled », région Francfort.
# Absente en développement : une base PGlite locale est créée dans .data/.
# DATABASE_URL=postgres://utilisateur:motdepasse@ep-xxx-pooler.eu-central-1.aws.neon.tech/terminal_arcade?sslmode=require

# --- Comptes (Better Auth) ---------------------------------------------------
# Secret de signature des sessions : 32 octets aléatoires au moins.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_SECRET=
# Adresse publique du site (https en production) : sert aux liens des e-mails
# et aux cookies sécurisés.
BETTER_AUTH_URL=http://localhost:3107

# Connexion Google : identifiant OAuth créé dans Google Cloud Console
# (type « Application Web », URI de redirection :
#  <BETTER_AUTH_URL>/api/auth/callback/google). Sans elles, le bouton Google
# est masqué.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- E-mails (Resend) --------------------------------------------------------
# Sans clé en développement, les e-mails s'affichent dans la console.
# L'expéditeur doit appartenir à un domaine vérifié dans Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Terminal Arcade <noreply@exemple.com>
